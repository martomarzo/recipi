# SQLite (ruta relativa a prisma/ — en Docker se usa file:/data/app.db)
DATABASE_URL="file:../data/app.db"

# Clave para firmar cookies de sesión — generar una aleatoria en producción
SECRET_KEY="cambiar-por-una-clave-aleatoria"

# true = cualquiera puede registrarse; false = solo con link de invitación
REGISTRATION_OPEN="true"

# Anthropic API key para el parseo de recetas importadas por link (opcional;
# sin clave se usa el parser de respaldo por regex)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# Auth key de Tailscale para el sidecar (solo hace falta la primera vez;
# generar en https://login.tailscale.com/admin/settings/keys)
TS_AUTHKEY=""

# Poner "false" solo si se accede por HTTP plano (LAN sin TLS) — permite
# que la cookie de sesión funcione sin HTTPS
COOKIE_SECURE=""
