# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@192.168.1.100:5432/recipi"

# Used by Next.js for server-side API calls (set to your container/host URL)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Anthropic API key for AI-powered recipe parsing (optional — falls back to manual parser)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Claude model to use for parsing (defaults to claude-haiku-4-5 if unset)
# Options: claude-haiku-4-5 (fast/cheap), claude-sonnet-4-6 (balanced), claude-opus-4-7 (best)
ANTHROPIC_MODEL="claude-haiku-4-5"
